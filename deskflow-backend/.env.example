# Environment variables for DeskFlow backend
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/deskflow?retryWrites=true&w=majority

# Port to run the server on (Render sets this automatically)
PORT=5000

# Your deployed frontend URL (for CORS). Use * to allow all origins during development.
FRONTEND_URL=https://your-frontend.vercel.app
